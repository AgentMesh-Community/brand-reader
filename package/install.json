{
  "format": "agent-install-v1",
  "runtimes": [
    {
      "name": "node",
      "version": ">=22"
    }
  ],
  "binaries": [
    {
      "name": "chromium",
      "purpose": "opens each fetched page to read what it renders: the computed faces, the colors by share of the page, and the contrast the site achieves; and takes one picture of the home page for the step that chooses which of the declared colors is the primary and which is the accent"
    }
  ],
  "dependencies": [
    {
      "skill": "read-a-brand",
      "lockfile": "skills/read-a-brand/scripts/package-lock.json",
      "sha256": "0f407d927e4aaa401268f058ad7513752f3016e940b03629e48a6fde7214184c"
    },
    {
      "skill": "look-at-what-it-does",
      "lockfile": "skills/look-at-what-it-does/scripts/package-lock.json",
      "sha256": "0f407d927e4aaa401268f058ad7513752f3016e940b03629e48a6fde7214184c"
    },
    {
      "skill": "choose-the-roles",
      "lockfile": "skills/choose-the-roles/scripts/package-lock.json",
      "sha256": "0f407d927e4aaa401268f058ad7513752f3016e940b03629e48a6fde7214184c"
    }
  ],
  "systems": [
    {
      "name": "source-host",
      "kind": "service"
    },
    {
      "name": "text-reasoning",
      "kind": "service",
      "credential": "text-reasoning-key",
      "env": "TEXT_API_KEY",
      "spends": {
        "unit": "calls"
      }
    }
  ],
  "ceilings": [
    {
      "system": "text-reasoning",
      "per": "task",
      "enforced_by": "runtime",
      "suggested": 2
    }
  ],
  "directories": [
    {
      "name": "records",
      "purpose": "one folder per job, holding the domain as asked, the pages as fetched, the statements, the observations, the picture of the home page, the roles as chosen and the draft profile"
    }
  ],
  "job_seconds": 600,
  "price": {
    "sku": "default",
    "covers": {
      "offerings": [
        "read-a-brand"
      ]
    },
    "price": {
      "model": "flat",
      "amount_micro": 1500000,
      "currency": "USD"
    }
  },
  "run": {
    "read-a-brand": {
      "command": [
        "node",
        "{home}/{package}/skills/read-a-brand/scripts/read-brand.mjs",
        "--job",
        "{job_dir}",
        "--records",
        "{records}",
        "--work",
        "{work}",
        "--text-file",
        "{job_dir}/message.txt"
      ],
      "reply": "json:reply",
      "message_file": "{job_dir}/message.txt"
    }
  }
}
